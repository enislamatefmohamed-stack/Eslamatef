{
  "version": 2,
  "outputDirectory": "build/web",
  "buildCommand": "bash build.sh",
  "routes": [
    {
      "src": "/robots.txt",
      "dest": "/api/robots.js"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap.js"
    },
    {
      "src": "/preview",
      "dest": "/api/preview.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/presentation/(.*)",
      "dest": "/presentation/$1"
    },
    {
      "src": "/presentation",
      "dest": "/presentation/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
