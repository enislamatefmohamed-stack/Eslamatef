rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================
    // 1. Security Helper Functions
    // ==============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authorization: checks custom claims or fallback to primary verified owner email
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'islamatef01016834012@gmail.com'
      );
    }

    // Allowed profile fields a student may update on their own document
    function isAllowedStudentProfileUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let allowedKeys = ['name', 'photoUrl', 'phone', 'whatsapp', 'country', 'lastLogin', 'lastActive', 'updatedAt'];
      return changedKeys.hasOnly(allowedKeys) &&
             (!changedKeys.hasAny(['name']) || (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100)) &&
             (!changedKeys.hasAny(['phone']) || request.resource.data.phone is string) &&
             (!changedKeys.hasAny(['whatsapp']) || request.resource.data.whatsapp is string) &&
             (!changedKeys.hasAny(['country']) || request.resource.data.country is string);
    }

    // Validation for quiz submission
    function isValidQuizSubmissionData() {
      let data = request.resource.data;
      let allowedFields = ['uid', 'quizId', 'quizTitle', 'score', 'totalQuestions', 'percentage', 'createdAt'];
      return data.keys().hasOnly(allowedFields) &&
             data.uid == request.auth.uid &&
             data.quizId is string && data.quizId.size() > 0 && data.quizId.size() <= 100 &&
             data.quizTitle is string && data.quizTitle.size() > 0 && data.quizTitle.size() <= 200 &&
             data.score is int && data.score >= 0 &&
             data.totalQuestions is int && data.totalQuestions > 0 &&
             data.score <= data.totalQuestions &&
             data.percentage is number && data.percentage >= 0 && data.percentage <= 100;
    }

    // Validation for challenge submission
    function isValidChallengeSubmissionData() {
      let data = request.resource.data;
      let allowedFields = ['uid', 'challengeId', 'challengeTitle', 'solutionUrl', 'codeSnippet', 'notes', 'createdAt'];
      return data.keys().hasOnly(allowedFields) &&
             data.uid == request.auth.uid &&
             data.challengeId is string && data.challengeId.size() > 0 &&
             data.challengeTitle is string && data.challengeTitle.size() > 0;
    }

    // Validation for contact message (Anti-spam / schema guard)
    function isValidContactMessage() {
      let data = request.resource.data;
      let allowedFields = ['name', 'email', 'phone', 'inquiryType', 'message', 'files', 'createdAt', 'timestamp', 'status'];
      return data.keys().hasOnly(allowedFields) &&
             data.name is string && data.name.size() > 1 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 4 && data.email.size() <= 100 &&
             data.message is string && data.message.size() > 2 && data.message.size() <= 3000;
    }

    // ==============================================================
    // 2. Users Collection (users) & Subcollections
    // ==============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) &&
                       request.resource.data.role == 'student' &&
                       request.resource.data.uid == request.auth.uid;
      
      allow update: if (isOwner(userId) && isAllowedStudentProfileUpdate()) || isAdmin();
      allow delete: if isAdmin();

      // Student Quiz Submissions subcollection
      match /quizzes/{quizId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidQuizSubmissionData() && !exists(/databases/$(database)/documents/users/$(userId)/quizzes/$(quizId));
        allow update, delete: if isAdmin();
      }

      // Student Challenge Submissions subcollection
      match /challenges/{challId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidChallengeSubmissionData() && !exists(/databases/$(database)/documents/users/$(userId)/challenges/$(challId));
        allow update, delete: if isAdmin();
      }

      // Student Gamification Points History subcollection
      match /points_history/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ==============================================================
    // 3. Global Submissions (quiz_submissions & challenge_submissions)
    // ==============================================================
    match /quiz_submissions/{subId} {
      allow create: if isAuthenticated() && isValidQuizSubmissionData() && !exists(/databases/$(database)/documents/quiz_submissions/$(subId));
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /challenge_submissions/{subId} {
      allow create: if isAuthenticated() && isValidChallengeSubmissionData() && !exists(/databases/$(database)/documents/challenge_submissions/$(subId));
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ==============================================================
    // 4. Courses & Subcollections (Phase 5: Subcollections Architecture)
    // ==============================================================
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      // Lessons subcollection inside courses
      match /lessons/{lessonId} {
        // Free lessons are public; paid lessons require admin role or active course/lesson entitlement
        allow read: if resource.data.isPaid != true || 
                       isAdmin() || 
                       (isAuthenticated() && (
                         courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.allowedCourses ||
                         lessonId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.allowedLessons
                       ));
        allow write: if isAdmin();
      }
    }

    // Global lessons collection (legacy compatibility & stand-alone curricula)
    match /lessons/{lessonId} {
      allow read: if resource.data.isPaid != true || 
                     isAdmin() || 
                     (isAuthenticated() && (
                       lessonId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.allowedLessons
                     ));
      allow write: if isAdmin();
    }

    // ==============================================================
    // 5. Educational Categories, Playlists & Quizzes
    // ==============================================================
    match /course_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lesson_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lesson_playlists/{playlistId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /interactive_quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /weekly_challenges/{challId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /latest_updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==============================================================
    // ==============================================================
    // 6. Contact Messages (Phase 8: Contact Form Security & Anti-Spam)
    // ==============================================================
    match /contact_messages/{messageId} {
      // Anyone can submit a message with schema validation
      allow create: if isValidContactMessage();
      // Only Admin can read messages, preventing any unauthorized user inspection
      allow read, update, delete: if isAdmin();
    }

    // ==============================================================
    // 7. Course Purchase Requests (طلبات الاشتراك في الكورسات)
    // ==============================================================
    match /purchase_requests/{reqId} {
      // Students or guests can submit purchase requests
      allow create: if true;
      // Only Admin can view, approve, or manage purchase requests
      allow read, update, delete: if isAdmin();
    }

    // ==============================================================
    // 7.1 Recording Lessons (استوديو التصوير والسبورة الذكية)
    // ==============================================================
    match /recording_lessons/{lessonId} {
      allow read, write: if true;
    }

    // ==============================================================
    // 8. Catch-All Deny (Default closed security)
    // ==============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
