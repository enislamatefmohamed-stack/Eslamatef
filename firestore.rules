rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Courses & Lectures Collection (الكورسات والمحاضرات)
    match /courses/{courseId} {
      allow read, write: if true;

      match /lessons/{lessonId} {
        allow read, write: if true;
      }
    }

    // 2. Articles & Comments Collection (المقالات والتعليقات والتصنيفات)
    match /articles/{articleId} {
      allow read, write: if true;

      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    match /article_categories/{catId} {
      allow read, write: if true;
    }

    // 3. Users, Enrollments, Quizzes, and Watched Lessons (الأعضاء وإنجازاتي)
    match /users/{userId} {
      allow read, write: if true;

      match /quizzes/{quizId} {
        allow read, write: if true;
      }

      match /enrollments/{courseId} {
        allow read, write: if true;
      }

      match /watched_lessons/{watchedId} {
        allow read, write: if true;
      }
    }

    // 4. Global Submissions & Notifications
    match /quiz_submissions/{subId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /contact_messages/{msgId} {
      allow read, write: if true;
    }

    match /challenge_submissions/{subId} {
      allow read, write: if true;
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

